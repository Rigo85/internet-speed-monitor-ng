{
  "name": "internet-speed-monitor-ng",
  "version": "1.0.2",
  "description": "Desktop internet speed monitor powered by Ookla Speedtest CLI, built with Electron and Angular",
  "main": "dist-electron-app/src-electron-app/main.js",
  "private": true,
  "author": "Rigoberto L. Salgado Reyes",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng build --base-href ./ && npm run build:electron && electron .",
    "build:angular": "ng build --base-href ./ --configuration production",
    "build:electron": "tsc -p electron-app-tsconfig.json",
    "build": "npm run build:angular && npm run build:electron",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.rigoberto.internet-speed-monitor",
    "productName": "Internet Speed Monitor",
    "copyright": "Copyright © 2024 Rigoberto L. Salgado Reyes",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron-app/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!src/**/*",
      "!src-electron-app/**/*",
      "!core/**/*",
      "!shared/**/*",
      "!test/**/*",
      "!release/**/*",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "core/ookla-speedtest",
        "to": "ookla-speedtest",
        "filter": [
          "linux/**",
          "win32/**"
        ]
      },
      {
        "from": "public/icon.png",
        "to": "icon.png",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "icon.ico"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Network",
      "synopsis": "Monitor internet speed using the Ookla Speedtest CLI",
      "desktop": {
        "entry": {
          "StartupWMClass": "Internet Speed Monitor"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@angular/animations": "^19.2.20",
    "@angular/common": "^19.2.20",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.20",
    "@angular/forms": "^19.2.20",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@angular/router": "^19.2.20",
    "angular-datatables": "^19.0.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.10.0",
    "bootstrap": "^5.3.3",
    "datatables.net": "^2.0.3",
    "datatables.net-bs5": "^2.0.3",
    "datatables.net-buttons": "^3.1.2",
    "datatables.net-buttons-dt": "^3.1.2",
    "jquery": "^3.6.0",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "tar": ">=7.5.13"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.23",
    "@angular/cli": "^19.2.23",
    "@angular/compiler-cli": "^19.2.20",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jquery": "^3.5.9",
    "electron": "^35.0.3",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vitest": "^3.1.1"
  }
}
